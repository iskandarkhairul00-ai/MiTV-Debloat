<!-- Glossy sheen over the Now Playing cover: a diagonal glare from the top-left, a soft shine
     across the top half, and a faint shade at the bottom for depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#73FFFFFF"
                android:centerColor="#14FFFFFF"
                android:centerX="0.42"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:bottom="44dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:top="56dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#40000000" />
        </shape>
    </item>
    <!-- light catching the top edge -->
    <item android:gravity="top" android:height="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
