<?xml version="1.0" encoding="utf-8"?>
<!-- Phone remote "Open on TV": a file the Files tab browsed, handed to the viewer app. FileApi
     only ever hands out paths inside a storage root, so expose just the storage tree
     (/storage/emulated/0 and removable volumes like /storage/XXXX-XXXX) instead of /. -->
<paths>
    <root-path name="storage" path="/storage/" />
</paths>
